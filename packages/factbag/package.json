{
  "name": "factbag",
  "version": "0.0.0-alpha.5",
  "keywords": [
    "logic",
    "rules-engine",
    "knowledge-base",
    "explainability",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/factbag/factbag/issues"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./dsl": {
        "types": "./dist/dsl.d.ts",
        "import": "./dist/dsl.js"
      },
      "./kb": {
        "types": "./dist/kb.d.ts",
        "import": "./dist/kb.js"
      },
      "./explain": {
        "types": "./dist/explain.d.ts",
        "import": "./dist/explain.js"
      },
      "./exceptions": {
        "types": "./dist/exceptions.d.ts",
        "import": "./dist/exceptions.js"
      },
      "./corpus": {
        "types": "./dist/corpus.d.ts",
        "import": "./dist/corpus.js"
      }
    }
  },
  "description": "Explainable fact and rule evaluation with document provenance and permission controls.",
  "homepage": "https://github.com/factbag/factbag/tree/main/packages/factbag#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/factbag/factbag.git",
    "directory": "packages/factbag"
  },
  "exports": {
    "./dsl": {
      "published": {
        "types": "./dist/dsl.d.ts",
        "import": "./dist/dsl.js"
      },
      "default": "./src/dsl.ts"
    },
    "./kb": {
      "published": {
        "types": "./dist/kb.d.ts",
        "import": "./dist/kb.js"
      },
      "default": "./src/kb.ts"
    },
    "./explain": {
      "published": {
        "types": "./dist/explain.d.ts",
        "import": "./dist/explain.js"
      },
      "default": "./src/explain.ts"
    },
    "./exceptions": {
      "published": {
        "types": "./dist/exceptions.d.ts",
        "import": "./dist/exceptions.js"
      },
      "default": "./src/exceptions.ts"
    },
    "./corpus": {
      "published": {
        "types": "./dist/corpus.d.ts",
        "import": "./dist/corpus.js"
      },
      "default": "./src/corpus.ts"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "tsdown": {
    "entry": {
      "dsl": "src/dsl.ts",
      "kb": "src/kb.ts",
      "explain": "src/explain.ts",
      "exceptions": "src/exceptions.ts",
      "corpus": "src/corpus.ts"
    },
    "dts": true,
    "fixedExtension": false,
    "copy": [
      {
        "from": "../../README.md",
        "to": "."
      }
    ],
    "deps": {
      "onlyBundle": [],
      "onlyImport": []
    },
    "publint": true,
    "attw": {
      "profile": "esm-only",
      "level": "error"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@factbag/core": "workspace:*",
    "@factbag/corpus": "workspace:*",
    "@factbag/guards": "workspace:*",
    "@factbag/tsconfig": "workspace:*",
    "publint": "catalog:"
  }
}
