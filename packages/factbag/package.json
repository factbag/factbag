{
  "name": "factbag",
  "version": "0.0.0-alpha.4",
  "keywords": [
    "logic",
    "rules-engine",
    "knowledge-base",
    "explainability",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/factbag/factbag/issues"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Explainable fact and rule evaluation, document provenance, permission controls, and Jev and Cloudflare Clef integrations.",
  "homepage": "https://github.com/factbag/factbag/tree/main/packages/factbag#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/factbag/factbag.git",
    "directory": "packages/factbag"
  },
  "exports": {
    "./dsl": {
      "types": "./dist/dsl.d.ts",
      "import": "./dist/dsl.js"
    },
    "./kb": {
      "types": "./dist/kb.d.ts",
      "import": "./dist/kb.js"
    },
    "./query": {
      "types": "./dist/query.d.ts",
      "import": "./dist/query.js"
    },
    "./explain": {
      "types": "./dist/explain.d.ts",
      "import": "./dist/explain.js"
    },
    "./exceptions": {
      "types": "./dist/exceptions.d.ts",
      "import": "./dist/exceptions.js"
    },
    "./corpus": {
      "types": "./dist/corpus.d.ts",
      "import": "./dist/corpus.js"
    },
    "./guards": {
      "types": "./dist/guards.d.ts",
      "import": "./dist/guards.js"
    },
    "./jev": {
      "types": "./dist/jev.d.ts",
      "import": "./dist/jev.js"
    },
    "./clef": {
      "types": "./dist/clef.d.ts",
      "import": "./dist/clef.js"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "tsdown": {
    "entry": {
      "dsl": "../core/src/dsl/index.ts",
      "kb": "../core/src/knowledge-base/index.ts",
      "query": "../core/src/query/index.ts",
      "explain": "../core/src/explanation/index.ts",
      "exceptions": "../core/src/exceptions/index.ts",
      "corpus": "../corpus/src/index.ts",
      "guards": "../guards/src/index.ts",
      "jev": "../../providers/jev/src/index.ts",
      "clef": "../../providers/clef/src/index.ts"
    },
    "dts": true,
    "fixedExtension": false,
    "copy": [
      {
        "from": "../../README.md",
        "to": "."
      }
    ],
    "deps": {
      "onlyBundle": [],
      "onlyImport": [
        "@typesafe-ai/sdk"
      ]
    },
    "publint": true,
    "attw": {
      "profile": "esm-only",
      "level": "error"
    }
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@factbag/clef": "workspace:*",
    "@factbag/core": "workspace:*",
    "@factbag/corpus": "workspace:*",
    "@factbag/guards": "workspace:*",
    "@factbag/jev": "workspace:*",
    "@factbag/system-one": "workspace:*",
    "@factbag/tsconfig": "workspace:*",
    "@typesafe-ai/sdk": "catalog:",
    "publint": "catalog:"
  },
  "peerDependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependenciesMeta": {
    "@typesafe-ai/sdk": {
      "optional": true
    }
  }
}
