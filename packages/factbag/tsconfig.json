{
  "extends": "@factbag/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    // Bundle workspace sources, not their builds, so entry points share one copy
    // of each class. Core's subpaths differ from its directories.
    "paths": {
      "@factbag/core/dsl": ["../core/src/dsl/index.ts"],
      "@factbag/core/kb": ["../core/src/knowledge-base/index.ts"],
      "@factbag/core/query": ["../core/src/query/index.ts"],
      "@factbag/core/explain": ["../core/src/explanation/index.ts"],
      "@factbag/core/exceptions": ["../core/src/exceptions/index.ts"],
      "@factbag/*": ["../*/src/index.ts"]
    }
  },
  "files": []
}
