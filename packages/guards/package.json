{
  "name": "@factbag/guards",
  "version": "0.1.0-next.0",
  "description": "Permission-enforcing views over Factbag knowledge bases.",
  "keywords": [
    "authorization",
    "policy",
    "rules-engine",
    "knowledge-base",
    "typescript"
  ],
  "homepage": "https://github.com/factbag/factbag/tree/main/packages/guards#readme",
  "bugs": {
    "url": "https://github.com/factbag/factbag/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/factbag/factbag.git",
    "directory": "packages/guards"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "api-report": "api-extractor run --local",
    "api-report:check": "api-extractor run",
    "build": "node ../../scripts/clean-output.ts dist && tsup src/index.ts --format esm --target node22 --platform node --splitting --sourcemap --out-dir dist && tsc -p tsconfig.build.json --emitDeclarationOnly && node ../../scripts/fix-declaration-specifiers.ts dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@factbag/core": "workspace:*"
  },
  "devDependencies": {
    "@factbag/tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
