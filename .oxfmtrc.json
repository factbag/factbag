{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["./README.md"],
      "options": {
        "printWidth": 80
      }
    }
  ],
  "ignorePatterns": [
    "**/coverage/**",
    "**/dist/**",
    "**/etc/*.api.md",
    "**/node_modules/**",
    "**/results/**",
    ".turbo/**",
    "pnpm-lock.yaml"
  ]
}
