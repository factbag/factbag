{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["FACTBAG_DATA_DIR"],
  "tasks": {
    "api-report": {
      "dependsOn": ["build"],
      "outputs": ["etc/*.api.md", "temp/*.api.json"]
    },
    "api-report:check": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "factbag#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "$TURBO_ROOT$/README.md"],
      "outputs": ["dist/**", "README.md"]
    },
    "//#oxlint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:examples": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    }
  },
  "globalDependencies": ["scripts/build-public-package.ts"]
}
