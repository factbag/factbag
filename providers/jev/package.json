{
  "name": "@factbag/jev",
  "version": "0.0.0-alpha.4",
  "description": "Lazy AI-assisted classification and evidence resolution for Factbag.",
  "keywords": [
    "classification",
    "evidence",
    "ai",
    "rules-engine",
    "typescript"
  ],
  "homepage": "https://github.com/factbag/factbag/tree/main/providers/jev#readme",
  "bugs": {
    "url": "https://github.com/factbag/factbag/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/factbag/factbag.git",
    "directory": "providers/jev"
  },
  "license": "Apache-2.0",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist/public",
    "docs/README.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "published": {
        "types": "./dist/public/index.d.ts",
        "import": "./dist/public/index.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.0.0 || ^26.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/public/index.d.ts",
        "import": "./dist/public/index.js"
      }
    }
  },
  "scripts": {
    "api-report": "api-extractor run --local",
    "api-report:check": "api-extractor run",
    "build": "tsdown && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "demo": "tsx examples/run.ts",
    "demo:staged": "tsx examples/staged-comparison.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "tsdown": [
    {
      "entry": [
        "src/index.ts"
      ],
      "dts": false,
      "sourcemap": true,
      "fixedExtension": false,
      "deps": {
        "neverBundle": true
      }
    },
    {
      "entry": {
        "index": "src/index.ts"
      },
      "outDir": "dist/public",
      "clean": false,
      "dts": true,
      "fixedExtension": false,
      "tsconfig": "tsconfig.public.json",
      "outputOptions": {
        "paths": {
          "@factbag/core/dsl": "factbag/dsl",
          "@factbag/core/kb": "factbag/kb",
          "@factbag/core/query": "factbag/dsl",
          "@factbag/core/explain": "factbag/explain",
          "@factbag/core/exceptions": "factbag/exceptions",
          "@factbag/corpus": "factbag/corpus",
          "@factbag/guards": "factbag/kb"
        }
      },
      "deps": {
        "alwaysBundle": [
          "@factbag/system-one"
        ],
        "neverBundle": true,
        "onlyImport": [
          "factbag",
          "@typesafe-ai/sdk"
        ]
      },
      "publint": true,
      "attw": {
        "profile": "esm-only",
        "level": "error"
      }
    }
  ],
  "devDependencies": {
    "@factbag/core": "workspace:*",
    "@factbag/corpus": "workspace:*",
    "@factbag/guards": "workspace:*",
    "@factbag/system-one": "workspace:*",
    "@factbag/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@typesafe-ai/sdk": "catalog:",
    "factbag": "workspace:*",
    "msw": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "factbag": "workspace:*",
    "@typesafe-ai/sdk": "^0.7.0"
  }
}
